{
	"name": "spd-front",
	"private": true,
	"version": "0.0.1",
	"license": "Apache-2.0",
	"repository": {
		"type": "git",
		"url": "git+https://github.com/SPICE-Protein/spd.git"
	},
	"packageManager": "pnpm@11.21.0",
	"type": "module",
	"scripts": {
		"dev": "vite dev",
		"build": "wrangler types --config=deploy/pages-router/wrangler.toml --check && vite build",
		"preview": "pnpm run build && wrangler dev --config wrangler.jsonc",
		"prepare": "svelte-kit sync || echo ''",
		"check": "wrangler types --config=deploy/pages-router/wrangler.toml --check && svelte-kit sync && svelte-check --tsconfig ./tsconfig.json",
		"check:watch": "svelte-kit sync && svelte-check --tsconfig ./tsconfig.json --watch",
		"lint": "prettier --check . && eslint .",
		"format": "prettier --write .",
		"test:unit": "vitest",
		"test": "npm run test:unit -- --run",
		"gen": "wrangler types --config=deploy/pages-router/wrangler.toml",
		"deploy": "pnpm run build && wrangler deploy --config wrangler.jsonc",
		"cf-typegen": "wrangler types --config=deploy/pages-router/wrangler.toml"
	},
	"devDependencies": {
		"@eslint/js": "^10.0.1",
		"@fontsource-variable/eb-garamond": "^5.3.0",
		"@fontsource-variable/jetbrains-mono": "^5.3.0",
		"@fontsource-variable/noto-serif": "^5.3.0",
		"@inlang/paraglide-js": "^2.18.2",
		"@internationalized/date": "^3.12.4",
		"@lucide/svelte": "^1.49.0",
		"@sveltejs/adapter-cloudflare": "^7.2.8",
		"@sveltejs/kit": "^2.63.0",
		"@sveltejs/vite-plugin-svelte": "^7.1.2",
		"@tailwindcss/vite": "^4.3.3",
		"@types/node": "^24",
		"@types/react": "^19.3.0",
		"@types/react-dom": "^19.3.0",
		"@vitest/browser-playwright": "^4.1.8",
		"bits-ui": "^2.19.3",
		"clsx": "^2.1.1",
		"eslint": "^10.4.1",
		"eslint-config-prettier": "^10.1.8",
		"eslint-plugin-svelte": "^3.19.0",
		"globals": "^17.6.0",
		"mode-watcher": "^1.1.0",
		"openapi-typescript": "^7.13.0",
		"playwright": "^1.60.0",
		"prettier": "^3.8.3",
		"prettier-plugin-svelte": "^4.1.0",
		"sass-embedded": "^1.105.0",
		"shadcn-svelte": "^1.7.0",
		"svelte": "^5.56.1",
		"svelte-check": "^4.6.0",
		"svelte-sonner": "^1.2.1",
		"tailwind-merge": "^3.6.0",
		"tailwind-variants": "^3.3.1",
		"tw-animate-css": "^1.4.0",
		"typescript": "^6.0.3",
		"typescript-eslint": "^8.60.1",
		"vite": "^8.0.16",
		"vitest": "^4.1.8",
		"vitest-browser-svelte": "^2.1.1",
		"wrangler": "^4.97.0"
	},
	"dependencies": {
		"@teselagen/bio-parsers": "^0.4.38",
		"dompurify": "^3.4.16",
		"kekule-svelte": "^0.1.2",
		"marked": "^18.0.14",
		"mermaid": "^12.3.0",
		"molstar": "^5.12.0",
		"react": "^19.3.0",
		"react-dom": "^19.3.0",
		"tailwindcss": "^4.3.3"
	}
}
